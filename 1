"""
import networkx as nx

G = nx.Graph()
G.add_edges_from([('A', 'B'), ('A', 'C'), ('B', 'D'), ('C', 'D'), ('D', 'E')])

node1, node2 = 'A', 'D'

print(f"Link Prediction Metrics between {node1} and {node2}:\n")

# 1. Graph Distance (Shortest Path)

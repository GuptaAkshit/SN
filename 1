"""
Experiment 8: Measure Influence via Reachability
"""
import networkx as nx

# 1. Setup Directed Graph (Information flow)
G = nx.DiGraph()
G.add_edges_from([('CEO', 'Manager1'), ('CEO', 'Manager2'),
                  ('Manager1', 'Emp1'), ('Manager1', 'Emp2'),
                  ('Manager2', 'Emp3'), ('Emp3', 'Intern')])

print("Influence via Reachability (Total Descendants):")

# 2. Calculate reachability for each node
influence_scores = {}
for node in G.nodes():
    # nx.descendants finds all nodes reachable from the source
    reachable_nodes = nx.descendants(G, node)
    influence_scores[node] = len(reachable_nodes)

# Sort by highest influence
for node, reach in sorted(influence_scores.items(), key=lambda x: x[1], reverse=True):
    print(f"   {node} can reach {reach} other node(s).")

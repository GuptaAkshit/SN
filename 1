"""
Experiment 2: Random Walk, Hitting Time, and Commute Time
"""
import networkx as nx
import random

def random_walk(G, start_node, target_node, max_steps=1000):
    curr = start_node
    steps = 0
    while curr != target_node and steps < max_steps:
        neighbors = list(G.neighbors(curr))
        if not neighbors:
            return float('inf') # Dead end
        curr = random.choice(neighbors)
        steps += 1
    return steps if curr == target_node else float('inf')

def expected_time(G, start, target, simulations=1000):
    total_steps = 0
    successful_runs = 0
    for _ in range(simulations):
        steps = random_walk(G, start, target)
        if steps != float('inf'):
            total_steps += steps
            successful_runs += 1
    return total_steps / successful_runs if successful_runs > 0 else float('inf')

# 1. Setup Graph
G = nx.Graph()
G.add_edges_from([(1, 2), (1, 3), (2, 4), (3, 4), (4, 5)])

node_A, node_B = 1, 5

# 2. Hitting Time (A to B)
hit_time_AB = expected_time(G, node_A, node_B)
print(f"Simulated Expected Hitting Time ({node_A} -> {node_B}): {hit_time_AB:.2f} steps")

# 3. Commute Time (A to B to A)
hit_time_BA = expected_time(G, node_B, node_A)
commute_time = hit_time_AB + hit_time_BA
print(f"Simulated Expected Commute Time ({node_A} <-> {node_B}): {commute_time:.2f} steps")





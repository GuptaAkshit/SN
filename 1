"""
Experiment 5: Page Rank Algorithm over Directed Graph
"""
import networkx as nx

# 1. Setup Directed Graph
G = nx.DiGraph()
edges = [('Home', 'About'), ('Home', 'Products'),
         ('About', 'Home'), ('Products', 'Cart'),
         ('Cart', 'Home'), ('Blog', 'Home')]
G.add_edges_from(edges)

# 2. Compute PageRank
# alpha = 0.85 is the standard damping factor (probability of clicking a link vs jumping randomly)
pagerank_scores = nx.pagerank(G, alpha=0.85)

print("Page Rank Scores:")
# Sort by highest importance
for page, score in sorted(pagerank_scores.items(), key=lambda x: x[1], reverse=True):
    print(f"   {page}: {score:.4f}")








"""
Experiment 4: Markov Cluster Algorithm
"""
import networkx as nx
import numpy as np

def normalize(matrix):
    # Normalize columns so they sum to 1
    col_sums = matrix.sum(axis=0)
    return matrix / col_sums

def expand(matrix):
    # Matrix squaring
    return np.dot(matrix, matrix)

def inflate(matrix, power):
    # Raise elements to power and normalize
    inflated = np.power(matrix, power)
    return normalize(inflated)

# 1. Setup Graph with self-loops (required for MCL to converge)
G = nx.Graph()
G.add_edges_from([(0,1), (0,2), (1,2), (3,4), (3,5), (4,5), (2,3)]) # Two clusters connected by 2-3
for node in G.nodes():
    G.add_edge(node, node)

# 2. Initialize Transition Matrix
A = nx.to_numpy_array(G)t
M = normalize(A)

# 3. MCL Loop
iterations = 20
power = 2.0 # Inflation parameter

for i in range(iterations):
    M = expand(M)
    M = inflate(M, power)

print("Converged MCL Matrix:")
print(np.round(M, 3))







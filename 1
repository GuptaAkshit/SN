"""
Experiment 7: Univariate Temporal Event Detection
"""
import numpy as np

# Simulated temporal data (e.g., number of interactions per day)
# Notice the spike on day 7
time_series = [10, 12, 11, 14, 13, 10, 55, 12, 11, 14]

window_size = 3
threshold = 2.0  # Z-score threshold for an anomaly

print("Event Detection Log:")
for i in range(window_size, len(time_series)):
    # Get recent history window
    window = time_series[i - window_size : i]
    current_value = time_series[i]

    # Calculate Mean and Std Dev
    mean = np.mean(window)
    std_dev = np.std(window)

    # Avoid division by zero
    if std_dev == 0:
        continue

    # Calculate Z-score
    z_score = (current_value - mean) / std_dev

    if z_score > threshold:
        print(f"EVENT DETECTED at time {i}! Value: {current_value}, Z-score: {z_score:.2f}")
    else:
        print(f"Time {i} normal. Value: {current_value}, Z-score: {z_score:.2f}")








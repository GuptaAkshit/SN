"""
Experiment 3: Neumann Kernel Proximity Measures
"""
import networkx as nx
import numpy as np

# 1. Setup Graph
G = nx.Graph()
G.add_edges_from([(0, 1), (0, 2), (1, 2), (2, 3)])

# 2. Get Adjacency Matrix
A = nx.to_numpy_array(G)
n = len(A)

# 3. Neumann Kernel Formula: K = (I - alpha * A)^-1
alpha = 0.1  # Decay factor
I = np.eye(n) # Identity Matrix

try:
    # Compute inverse
    neumann_kernel = np.linalg.inv(I - alpha * A)
    print("Neumann Kernel Proximity Matrix:")
    print(np.round(neumann_kernel, 3))
except np.linalg.LinAlgError:
    print("Matrix inversion failed. Alpha might be too large.")






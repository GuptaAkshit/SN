    distance = nx.shortest_path_length(G, source=node1, target=node2)
    print(f"Graph Distance: {distance}")
except nx.NetworkXNoPath:
    print("Graph Distance: Infinite (No path)")

# 2. Common Neighbors
common_neigh = list(nx.common_neighbors(G, node1, node2))
print(f"Common Neighbors Count: {len(common_neigh)} {common_neigh}")

# 3. Jaccard's Coefficient
# NetworkX requires a list of node pairs to compute Jaccard
jaccard = list(nx.jaccard_coefficient(G, [(node1, node2)]))
print(f"Jaccard's Coefficient: {jaccard[0][2]:.4f}")








